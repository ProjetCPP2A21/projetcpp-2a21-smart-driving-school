      <property name="styleSheet">
       <string notr="true">/* Style global du tableau */
QTableWidget, QTableView {
    background-color: white;          /* fond neutre */
    border: 2px solid #43cea2;        /* contour vert-bleu */
    border-radius: 12px;
    gridline-color: #dcdcdc;          /* lignes discrètes */
    selection-background-color: #43cea2;
    selection-color: white;
}

/* En-têtes horizontaux */
QHeaderView::section {
    background: white;                /* fond neutre */
    color: #2c3e50;                   /* texte gris foncé */
    padding: 4px;
    border: 1px solid #43cea2;        /* contour vert-bleu */
    border-radius: 6px;
}

/* Lignes de cellule */
QTableWidget::item {
    padding: 4px;
    border-bottom: 1px solid #eaeaea; /* lignes grises claires */
}

/* Lignes au survol */
QTableWidget::item:hover {
    background-color: rgba(67, 206, 162, 0.1); /* léger voile vert */
}

/* Lignes sélectionnées */
QTableWidget::item:selected {
    background-color: #43cea2;        /* vert-bleu */
    color: white;
}

/* Scrollbars sobres */
QScrollBar:vertical {
    border: none;
    background: #f0f0f0;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #43cea2;              /* juste la poignée colorée */
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-</string>
      </property>
     </widget>
