     <widget class="QDateEdit" name="dateEdit_naissance">
      <property name="geometry">
       <rect>
        <x>80</x>
        <y>350</y>
        <width>170</width>
        <height>41</height>
       </rect>
      </property>
      <property name="styleSheet">
       <string notr="true">QDateEdit {
    border: 2px solid qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #43cea2, stop:1 #185a9d);
    border-radius: 10px;
    padding: 4px 8px;
    background: white;
    color: #2c3e50;
    min-width: 120px;
    max-width: 150px;
    height: 24px;
}

/* Bouton pour ouvrir le calendrier */
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border: none;
    background: transparent;
}

/* Flèche du calendrier */
QDateEdit::down-arrow {
    image: url(:/icons/calendar-white.png);
    width: 12px;
    height: 12px;
}

/* Focus */
QDateEdit:focus {
    border: 2px solid qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #ff4b1f, stop:1 #ffc837);
    box-shadow: 0 0 4px rgba(255, 107, 53, 0.6);
}

/* Hover */
QDateEdit:hover {
    border: 2px solid #43cea2;
    box-shadow: 0 0 4px rgba(67, 206, 162, 0.6);
}

/* Menu du calendrier */
QCalendarWidget QWidget {
    background-color: white;
}

QCalendarWidget QToolButton {
    background-color: #43cea2;
    color: white;
    border-radius: 4px;
}

QCalendarWidget QSpinBox {
    width: 60px;
}
</string>
