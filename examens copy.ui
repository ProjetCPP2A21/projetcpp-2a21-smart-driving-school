      <property name="styleSheet">
       <string notr="true">QTableWidget, QTableView {
    background-color: white;
    border: 2px solid #43cea2;
    border-radius: 12px;
    gridline-color: #dcdcdc;
    selection-background-color: #43cea2;
    selection-color: white;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #43cea2,
        stop:1 #185a9d);
    color: white;
    padding: 4px;
    border: 1px solid #144d7e;
    border-radius: 6px;
    font-weight: bold;
}

QTableWidget::item {
    padding: 4px;
    border-bottom: 1px solid #eaeaea;
}

QTableWidget::item:hover {
    background-color: rgba(67, 206, 162, 0.1);
}

QTableWidget::item:selected {
    background-color: #43cea2;
    color: white;
}

QScrollBar:vertical {
    border: none;
    background: #f0f0f0;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #43cea2;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}</string>
      </property>
