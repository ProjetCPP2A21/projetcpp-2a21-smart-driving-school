  <property name="styleSheet">
   <string notr="true">/* ========== STYLE GLOBAL MODERNE ========== */
QMainWindow {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #667eea,
        stop:0.5 #764ba2,
        stop:1 #2c3e50
    );
}

QWidget#centralwidget {
    background: transparent;
}

/* ========== LABELS MODERNES ========== */
QLabel {
    color: #ffffff;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 10pt;
    font-weight: 600;
    background: transparent;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
}

/* ========== BOUTONS PRIMAIRES (Ajouter, Modifier) ========== */
QPushButton#ajouter, QPushButton#modifier {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #667eea,
        stop:1 #764ba2);
    color: white;
    border: none;
    border-radius: 15px;
    padding: 12px 24px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 11pt;
    font-weight: 600;
    min-height: 45px;
}

QPushButton#ajouter:hover, QPushButton#modifier:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #764ba2,
        stop:1 #667eea);
    transform: translateY(-2px);
}

QPushButton#ajouter:pressed, QPushButton#modifier:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #5568d3,
        stop:1 #653a8f);
}

/* ========== BOUTON DANGER (Supprimer) ========== */
QPushButton#suprimer {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #f093fb,
        stop:1 #f5576c);
    color: white;
    border: none;
    border-radius: 15px;
    padding: 12px 24px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 11pt;
    font-weight: 600;
    min-height: 45px;
}

QPushButton#suprimer:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #f5576c,
        stop:1 #f093fb);
}

QPushButton#suprimer:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #e0455a,
        stop:1 #d981e9);
}

/* ========== BOUTONS SECONDAIRES (PDF, Statistiques, Tri) ========== */
QPushButton#pdf, QPushButton#stat, QPushButton#tri {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #43cea2,
        stop:1 #185a9d);
    color: white;
    border: none;
    border-radius: 15px;
    padding: 12px 24px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 11pt;
    font-weight: 600;
    min-height: 45px;
}

QPushButton#pdf:hover, QPushButton#stat:hover, QPushButton#tri:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #185a9d,
        stop:1 #43cea2);
    box-shadow: 0 4px 15px rgba(67, 206, 162, 0.4);
}

QPushButton#pdf:pressed, QPushButton#stat:pressed, QPushButton#tri:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #144d7e,
        stop:1 #35b890);
}

/* ========== BOUTONS SPÉCIAUX (Taux Réussite, Affecter Véhicule) ========== */
QPushButton#tauxReussite, QPushButton#affecterVehicule {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #fa709a,
        stop:1 #fee140);
    color: #2c3e50;
    border: none;
    border-radius: 15px;
    padding: 12px 24px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 11pt;
    font-weight: 600;
    min-height: 45px;
}

QPushButton#tauxReussite:hover, QPushButton#affecterVehicule:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #fee140,
        stop:1 #fa709a);
    box-shadow: 0 4px 15px rgba(250, 112, 154, 0.4);
}

QPushButton#tauxReussite:pressed, QPushButton#affecterVehicule:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #f8d030,
        stop:1 #e85a88);
}

/* ========== BOUTON RETOUR ========== */
QPushButton#Retour {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4facfe,
        stop:1 #00f2fe);
    color: white;
    border: none;
    border-radius: 15px;
    padding: 12px 24px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 11pt;
    font-weight: 600;
    min-height: 45px;
}

QPushButton#Retour:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #00f2fe,
        stop:1 #4facfe);
    box-shadow: 0 4px 15px rgba(79, 172, 254, 0.4);
}

QPushButton#Retour:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3d9be8,
        stop:1 #00d9e8);
}

/* ========== CHAMPS DE SAISIE MODERNES ========== */
QLineEdit {
    background: white;
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    padding: 10px 15px;
    color: #2c3e50;
    font-family: 'Segoe UI', sans-serif;
    font-size: 10pt;
    selection-background-color: #667eea;
    selection-color: white;
}

QLineEdit:focus {
    border: 2px solid #667eea;
    background: #fafafa;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

QLineEdit:hover {
    border: 2px solid #b0b0b0;
    background: #fafafa;
}

QLineEdit::placeholder {
    color: #95a5a6;
    font-style: italic;
}

/* ========== COMBOBOX MODERNES ========== */
QComboBox {
    background: white;
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    padding: 10px 15px;
    color: #2c3e50;
    font-family: 'Segoe UI', sans-serif;
    font-size: 10pt;
    min-height: 20px;
}

QComboBox:hover {
    border: 2px solid #b0b0b0;
    background: #fafafa;
}

QComboBox:focus {
    border: 2px solid #667eea;
    background: #fafafa;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left: 1px solid #e0e0e0;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #667eea;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    background: white;
    border: 2px solid #667eea;
    border-radius: 8px;
    selection-background-color: #667eea;
    selection-color: white;
    padding: 5px;
}

/* ========== SPINBOX MODERNE ========== */
QSpinBox {
    background: white;
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    padding: 10px 15px;
    color: #2c3e50;
    font-family: 'Segoe UI', sans-serif;
    font-size: 10pt;
}

QSpinBox:hover {
    border: 2px solid #b0b0b0;
    background: #fafafa;
}

QSpinBox:focus {
    border: 2px solid #667eea;
    background: #fafafa;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

QSpinBox::up-button, QSpinBox::down-button {
    background: transparent;
    border: none;
    width: 25px;
}

QSpinBox::up-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 6px solid #667eea;
    width: 0;
    height: 0;
}

QSpinBox::down-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #667eea;
    width: 0;
    height: 0;
}

/* ========== TABLEAU PREMIUM ========== */
QTableWidget {
    background: white;
    border: 2px solid #e0e0e0;
    border-radius: 15px;
    gridline-color: #f0f0f0;
    selection-background-color: #667eea;
    selection-color: white;
    font-family: 'Segoe UI', sans-serif;
    font-size: 10pt;
    alternate-background-color: #f8f9fa;
}

QTableWidget::item {
    padding: 8px;
    border: none;
}

QTableWidget::item:hover {
    background-color: rgba(102, 126, 234, 0.1);
}

QTableWidget::item:selected {
    background-color: #667eea;
    color: white;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #667eea,
        stop:1 #764ba2);
    color: white;
    padding: 12px;
    border: none;
    font-family: 'Segoe UI', sans-serif;
    font-size: 10pt;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QHeaderView::section:first {
    border-top-left-radius: 13px;
}

QHeaderView::section:last {
    border-top-right-radius: 13px;
}

/* ========== SCROLLBAR MODERNE ========== */
QScrollBar:vertical {
    background: #f0f0f0;
    width: 12px;
    border: none;
    border-radius: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #667eea;
    border-radius: 6px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #764ba2;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: #f0f0f0;
    height: 12px;
    border: none;
    border-radius: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #667eea;
    border-radius: 6px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #764ba2;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}</string>
