     <string notr="true">QGroupBox {
    font-weight: bold;
    font-size: 16px;
    color: #2c3e50;
    border: 3px solid qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #43cea2, stop:1 #185a9d);
    border-radius: 15px;
    margin-top: 15px;
    padding-top: 15px;
    background: rgba(255, 255, 255, 0.95);
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 8px 0 8px;
    background: white;
    color: #2c3e50;
    font-weight: bold;
    font-size: 16px;
}</string>
